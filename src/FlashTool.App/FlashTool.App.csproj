<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>FlashTool</AssemblyName>
    <RootNamespace>FlashTool.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- CA1822: data-bound members must be instance members. CA1001: app-lifetime singletons. -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
    <!-- The publish target of 7z.Libs breaks RID-specific publishing (MSB4096); 7z.dll is published below instead. -->
    <NG7zLibsResolvePublish>false</NG7zLibsResolvePublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Native 7z.dll (x86/x64) copied to the output folder. -->
    <PackageReference Include="7z.Libs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashTool.Core\FlashTool.Core.csproj" />
    <ProjectReference Include="..\FlashTool.Platform.Windows\FlashTool.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Publish only 7z.dll and its license (the build output also gets them from the 7z.Libs targets). -->
  <ItemGroup Condition="'$(NG7zLibsPathToBin)' != ''">
    <None Include="$(NG7zLibsPathToBin)x64\7z.dll" Link="x64\7z.dll" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NG7zLibsPathToBin)x86\7z.dll" Link="x86\7z.dll" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NG7zLibsPathToBin)License.txt" Link="x64\License.7z.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NG7zLibsPathToBin)License.txt" Link="x86\License.7z.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
