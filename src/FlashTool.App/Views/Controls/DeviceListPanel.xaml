<UserControl
    x:Class="FlashTool.App.Views.Controls.DeviceListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FlashTool.App.Views.Controls"
    xmlns:loc="clr-namespace:FlashTool.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">
    <!-- DataContext: a page view model exposing Devices (DeviceListService) and SelectedDevice. -->
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding Title, ElementName=Root}" Margin="0" />
            <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{loc:Tr Devices_ShowAll}" />
                <ui:ToggleSwitch IsChecked="{Binding Devices.ShowAllDisks}" />
            </StackPanel>
            <ui:Button
                Grid.Column="2"
                Command="{Binding Devices.RefreshCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                ToolTip="{loc:Tr Devices_Refresh}" />
        </Grid>

        <ui:Card Padding="4">
            <Grid>
                <ListBox
                    MinHeight="72"
                    MaxHeight="260"
                    ItemTemplate="{StaticResource DeviceItemTemplate}"
                    ItemsSource="{Binding Devices.Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RequireWritable, RelativeSource={RelativeSource AncestorType=local:DeviceListPanel}}" Value="True" />
                                        <Condition Binding="{Binding CanBeWritten}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    Text="{loc:Tr Devices_None}"
                    Visibility="{Binding Devices.HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:ProgressRing
                    Width="20"
                    Height="20"
                    Margin="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{Binding Devices.IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ui:Card>
    </StackPanel>
</UserControl>
