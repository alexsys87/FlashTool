<Page
    x:Class="FlashTool.App.Views.Pages.WritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlashTool.App.Views.Controls"
    xmlns:loc="clr-namespace:FlashTool.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900">
            <TextBlock Margin="0,0,0,20" FontSize="26" FontWeight="SemiBold" Text="{loc:Tr Write_Header}" />

            <!-- Image source -->
            <controls:ImageSourcePanel Margin="0,0,0,20" DataContext="{Binding Image}" />

            <!-- Target device -->
            <controls:DeviceListPanel Margin="0,0,0,8" RequireWritable="True" Title="{loc:Tr Write_TargetTitle}" />
            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding SizeWarning}"
                Severity="Error"
                Visibility="{Binding SizeWarning, Converter={StaticResource NullToVisibility}}" />

            <!-- What is on the selected device now -->
            <StackPanel Margin="0,0,0,12" Visibility="{Binding Preview.IsVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding Preview.Summary}"
                    TextWrapping="Wrap" />
                <DataGrid
                    Margin="0,8,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Preview.Partitions}"
                    Visibility="{Binding Preview.HasPartitions, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Number}" Header="#" />
                        <DataGridTextColumn Width="*" Binding="{Binding Type}" Header="{loc:Tr Image_Type}" />
                        <DataGridTextColumn Binding="{Binding FileSystem}" Header="FS" />
                        <DataGridTextColumn Binding="{Binding Name}" Header="{loc:Tr Preview_LabelColumn}" />
                        <DataGridTextColumn Binding="{Binding Size}" Header="{loc:Tr Image_Size}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Options -->
            <TextBlock Margin="0,12,0,8" Style="{StaticResource SectionTitle}" Text="{loc:Tr Write_OptionsTitle}" />
            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Message="{loc:Tr Write_DifferentialOn}"
                Severity="Informational"
                Visibility="{Binding DifferentialWrite, Converter={StaticResource BoolToVisibility}}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Write_Verify}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Write_VerifyDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Verify}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Fingerprint24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Write_Checksum}" />
                        <TextBlock
                            Style="{StaticResource SecondaryText}"
                            Text="{loc:Tr Write_ChecksumDescription}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding ChecksumStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ChecksumStatus, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox
                    Width="460"
                    FontFamily="Consolas"
                    FontSize="12"
                    PlaceholderText="{loc:Tr Write_ChecksumPlaceholder}"
                    Text="{Binding ExpectedChecksum, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Map24}" Visibility="{Binding Bmap.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Write_Bmap}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Write_BmapDescription}" TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Bmap.StatusText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Bmap.StatusText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Bmap.UseFound}" IsEnabled="{Binding Bmap.CanUse}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Storage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Write_Expand}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Write_ExpandDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ExpandLastPartition}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ArrowEject20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Write_Eject}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Write_EjectDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding EjectAfterWrite}" />
            </ui:CardControl>

            <!-- Action -->
            <controls:OperationPanel Margin="0,0,0,12" DataContext="{Binding Progress}" />
            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="{Binding Result.IsOpen, Mode=TwoWay}"
                Message="{Binding Result.Message}"
                Severity="{Binding Result.Severity}"
                Title="{Binding Result.Title}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Tr Cancel}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="{Binding Operation.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="160"
                    Appearance="Primary"
                    Command="{Binding WriteCommand}"
                    Content="{loc:Tr Write_Start}"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
