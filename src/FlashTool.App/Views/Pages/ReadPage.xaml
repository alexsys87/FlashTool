<Page
    x:Class="FlashTool.App.Views.Pages.ReadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlashTool.App.Views.Controls"
    xmlns:loc="clr-namespace:FlashTool.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900">
            <TextBlock Margin="0,0,0,20" FontSize="26" FontWeight="SemiBold" Text="{loc:Tr Read_Header}" />

            <!-- Source device -->
            <controls:DeviceListPanel Margin="0,0,0,8" RequireWritable="False" Title="{loc:Tr Read_SourceTitle}" />
            <TextBlock Margin="4,0,0,20" Style="{StaticResource SecondaryText}" Text="{Binding LayoutText}" />

            <!-- Destination -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Read_DestinationTitle}" />
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Icon="{ui:SymbolIcon Save24}" PlaceholderText="{loc:Tr Read_DestinationHint}" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SaveAsCommand}" Content="{loc:Tr Read_SaveAs}" Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SecondaryText}" Text="{loc:Tr Read_Format}" />
                            <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" IsEnabled="{Binding IsCompressed}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SecondaryText}" Text="{loc:Tr Read_Compression}" />
                            <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Compressions}" SelectedItem="{Binding SelectedCompression}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Options -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Write_OptionsTitle}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Storage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Read_OnlyAllocated}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Read_OnlyAllocatedDescription}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding WillReadText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding OnlyAllocatedPartitions}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Read_Verify}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Read_VerifyDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Verify}" />
            </ui:CardControl>

            <!-- Action -->
            <controls:OperationPanel Margin="0,0,0,12" DataContext="{Binding Progress}" />
            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="{Binding Result.IsOpen, Mode=TwoWay}"
                Message="{Binding Result.Message}"
                Severity="{Binding Result.Severity}"
                Title="{Binding Result.Title}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Tr Cancel}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="{Binding Operation.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="160"
                    Appearance="Primary"
                    Command="{Binding StartCommand}"
                    Content="{loc:Tr Read_Start}"
                    Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
