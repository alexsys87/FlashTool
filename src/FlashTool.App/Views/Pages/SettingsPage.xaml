<Page
    x:Class="FlashTool.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FlashTool.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900">
            <TextBlock Margin="0,0,0,20" FontSize="26" FontWeight="SemiBold" Text="{loc:Tr Settings_Header}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Appearance}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Theme}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_ThemeDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="180" DisplayMemberPath="Text" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Language}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_LanguageDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="180" DisplayMemberPath="Text" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Devices}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon HardDrive20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Devices_ShowAll}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_ShowAllDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Devices.ShowAllDisks}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Writing}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_DifferentialWrite}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_DifferentialWriteDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding DifferentialWrite}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Imaging}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon FastForward24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_SkipFreeBlocks}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_SkipFreeBlocksDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding SkipFreeBlocks}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Bmap}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Map24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_UseBmap}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_UseBmapDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding UseBmap}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon DocumentData24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_CreateBmap}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_CreateBmapDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding CreateBmap}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Erase}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Eraser24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_EraseEnable}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_EraseDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <!-- One-way: the command asks for confirmation before the setting changes. -->
                <ui:ToggleSwitch Command="{Binding ToggleEraseCommand}" IsChecked="{Binding EraseEnabled, Mode=OneWay}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_DeviceTest}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon TopSpeed24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_DeviceTestEnable}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_DeviceTestDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding DeviceTestEnabled}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Update_Section}" />
            <ui:Card Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Margin="0,2,16,0" VerticalAlignment="Top" FontSize="24" Symbol="ArrowSyncCircle24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Tr Update_Title}" />
                        <TextBlock
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding Updates.StatusText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Updates.StatusText, Converter={StaticResource NullToVisibility}}" />
                        <ProgressBar
                            Margin="0,8,0,0"
                            IsIndeterminate="{Binding Updates.IsProgressIndeterminate}"
                            Maximum="100"
                            Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}"
                            Value="{Binding Updates.Progress}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding DownloadUpdateCommand}"
                                Content="{loc:Tr Update_Download}"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Visibility="{Binding Updates.CanDownload, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding InstallUpdateCommand}"
                                Content="{loc:Tr Update_Install}"
                                Icon="{ui:SymbolIcon Box24}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Updates.HasDownload}" Value="True" />
                                                    <Condition Binding="{Binding Updates.IsInstaller}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button
                                Margin="0,0,8,0"
                                Command="{Binding ShowUpdateInFolderCommand}"
                                Content="{loc:Tr Update_ShowInFolder}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Visibility="{Binding Updates.HasDownload, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Command="{Binding OpenReleasePageCommand}"
                                Content="{loc:Tr Update_ReleaseNotes}"
                                Icon="{ui:SymbolIcon Open24}"
                                Visibility="{Binding Updates.HasRelease, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Command="{Binding CancelUpdateCommand}"
                                Content="{loc:Tr Cancel}"
                                Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                    <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="{loc:Tr Update_Check}" />
                </Grid>
            </ui:Card>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CalendarSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Update_CheckAutomatically}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Update_CheckAutomaticallyDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Updates.CheckAutomatically}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Beaker24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Update_IncludePrereleases}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Update_IncludePrereleasesDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Updates.IncludePrereleases}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_About}" />
            <ui:Card>
                <StackPanel Orientation="Horizontal">
                    <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top" Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="FlashTool" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding VersionText}" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{loc:Tr Settings_AboutText}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" Text="{Binding FormatsText}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding AdminText}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
