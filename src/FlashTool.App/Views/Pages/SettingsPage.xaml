<Page
    x:Class="FlashTool.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FlashTool.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900">
            <TextBlock Margin="0,0,0,20" FontSize="26" FontWeight="SemiBold" Text="{loc:Tr Settings_Header}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Appearance}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Theme}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_ThemeDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="180" DisplayMemberPath="Text" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Language}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_LanguageDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="180" DisplayMemberPath="Text" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Devices}" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon HardDrive24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Devices_ShowAll}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Settings_ShowAllDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Devices.ShowAllDisks}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_About}" />
            <ui:Card>
                <StackPanel Orientation="Horizontal">
                    <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top" Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="FlashTool" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding VersionText}" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{loc:Tr Settings_AboutText}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" Text="{Binding FormatsText}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding AdminText}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
